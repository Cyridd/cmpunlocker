open-gpu-kernel-modules-610.57.04/
open-gpu-kernel-modules-610.57.04.tar.gz
artifacts/

# Windows tree build outputs (see windows/README.md)
windows/release-fork/
windows/build-linux/
windows/tools/unlock40x/*.o
windows/tools/unlock40x/*.so
windows/tools/unlock40x/unlock40x_v70.efi

# Locally signed EFI copies (see windows/tools/unlock40x/sign_efi.sh).
# A signature is bound to the signer's private key, so these are per-machine
# files: committing one would break the reproducible-build hash and would be
# unverifiable for everyone else.
windows/tools/unlock40x/*.signed.efi

# Prebuilt executables are published through GitHub Releases (with SHA256SUMS.txt),
# not committed. CI and windows/tools/build_release.bat build them from source.
*.exe

# Userspace pipeline patch: the patched library is a modified copy of NVIDIA's
# proprietary libnvidia-glcore.so and is generated locally, never committed.
cmp_glcore_patch/patch_glcore
cmp_glcore_patch/libnvidia-glcore.so*
