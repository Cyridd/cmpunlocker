# Preserve raw EFI serial bytes, including firmware's CRLF line endings.
*.log -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
*.LOG -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# Preserve trailing firmware console output spaces as well.
**/serial.log whitespace=-blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
