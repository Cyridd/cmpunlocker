#version 450
layout(local_size_x=8, local_size_y=8, local_size_z=1) in;
layout(set=0,binding=0, rgba8) uniform writeonly image2D outImage;
layout(push_constant) uniform PC { uint iters; } pc;
void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, imageSize(outImage)))) return;
    float x = (float(p.x) + 0.5) / 2048.0;
    float y = (float(p.y) + 0.5) / 2048.0;
    for (uint i = 0u; i < pc.iters; ++i) {
        x = fma(x, 0.9991, 0.00031);
        y = fma(y, 0.9993, 0.00017);
    }
    imageStore(outImage, p, vec4(x, y, x * 0.5 + y * 0.25, 1.0));
}
