+static void
+s_captureCmp40NativeBooterState
+(
+    OBJGPU *pGpu,
+    KernelFalcon *pKernelFlcn,
+    NV_STATUS booterStatus
+)
+{
+    NvU32 pcCmd;
+    NvU32 pcData;
+    NvU32 spCmd;
+    NvU32 spData;
+    NvU32 imemc;
+    NvU32 imem[8];
+    NvU32 i;
+
+    kflcnRegWrite_HAL(pGpu, pKernelFlcn, CMP40_FALCON_ICD_CMD,
+                      CMP40_FALCON_ICD_RREG | (CMP40_FALCON_REG_PC << 8));
+    pcCmd = kflcnRegRead_HAL(pGpu, pKernelFlcn, CMP40_FALCON_ICD_CMD);
+    pcData = kflcnRegRead_HAL(pGpu, pKernelFlcn, CMP40_FALCON_ICD_RDATA);
+
+    kflcnRegWrite_HAL(pGpu, pKernelFlcn, CMP40_FALCON_ICD_CMD,
+                      CMP40_FALCON_ICD_RREG | (CMP40_FALCON_REG_SP << 8));
+    spCmd = kflcnRegRead_HAL(pGpu, pKernelFlcn, CMP40_FALCON_ICD_CMD);
+    spData = kflcnRegRead_HAL(pGpu, pKernelFlcn, CMP40_FALCON_ICD_RDATA);
+
+    imemc = kflcnMaskImemAddr_HAL(pGpu, pKernelFlcn, 0U);
+    imemc |= CMP40_FALCON_IMEMC_AINCR;
+    kflcnRegWrite_HAL(pGpu, pKernelFlcn,
+                      NV_PFALCON_FALCON_IMEMC(0), imemc);
+    for (i = 0; i < NV_ARRAY_ELEMENTS(imem); i++)
+    {
+        imem[i] = kflcnRegRead_HAL(pGpu, pKernelFlcn,
+                                   NV_PFALCON_FALCON_IMEMD(0));
+    }
+
+    NV_PRINTF(LEVEL_ERROR,
+              "CMP40_NATIVE_BOOTER_STATE: status=0x%x cpuctl=0x%08x "
+              "irqstat=0x%08x debuginfo=0x%08x traceidx=0x%08x "
+              "tracepc=0x%08x\n",
+              booterStatus,
+              kflcnRegRead_HAL(pGpu, pKernelFlcn,
+                               NV_PFALCON_FALCON_CPUCTL),
+              kflcnRegRead_HAL(pGpu, pKernelFlcn,
+                               NV_PFALCON_FALCON_IRQSTAT),
+              kflcnRegRead_HAL(pGpu, pKernelFlcn,
+                               NV_PFALCON_FALCON_DEBUGINFO),
+              kflcnRegRead_HAL(pGpu, pKernelFlcn, CMP40_FALCON_TRACEIDX),
+              kflcnRegRead_HAL(pGpu, pKernelFlcn, CMP40_FALCON_TRACEPC));
+    NV_PRINTF(LEVEL_ERROR,
+              "CMP40_NATIVE_BOOTER_ICD: pc_cmd=0x%08x pc=0x%08x "
+              "sp_cmd=0x%08x sp=0x%08x\n",
+              pcCmd, pcData, spCmd, spData);
+    NV_PRINTF(LEVEL_ERROR,
+              "CMP40_NATIVE_BOOTER_IMEM0: %08x %08x %08x %08x "
+              "%08x %08x %08x %08x\n",
+              imem[0], imem[1], imem[2], imem[3],
+              imem[4], imem[5], imem[6], imem[7]);
+}
 
