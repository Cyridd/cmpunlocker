+static NvBool
+s_isCmp40Device
+(
+    OBJGPU *pGpu
+)
+{
+    return (pGpu->idInfo.PCIDeviceID == 0x1F0B10DEU) &&
+           (1);
+}
+
+static NvBool
+s_isCmp40NativeBooterProbe
+(
+    OBJGPU *pGpu
+)
+{
+    return s_isCmp40Device(pGpu) && kgspCmp40GetExploitMode(pGpu);
+}
