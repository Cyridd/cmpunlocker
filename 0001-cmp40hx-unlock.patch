+            (GPU_REG_RD32(pGpu, CMP40_WPR2_ADDR_HI) == 0x00000000U) &&
+            (GPU_REG_RD32(pGpu, CMP40_FECS_SPEED0) ==
+             CMP40_FECS_SPEED0_STAGED) &&
+            (GPU_REG_RD32(pGpu, CMP40_FECS_SPEED1) ==
+             CMP40_FECS_SPEED1_STAGED) &&
+            (GPU_REG_RD32(pGpu, CMP40_SEC2_RESET_PLM) ==
+             CMP40_SEC2_RESET_PLM_POSTEXIT) &&
+            (mailbox0 == 0U) &&
+            ((mailbox1 == 0U) || (mailbox1 == 1U)))
+        {
+            if (mailbox1 != 0U)
+            {
+                NV_PRINTF(LEVEL_ERROR,
+                          "CMP40_STOCKFLOW_V551: MAILBOX1_ACCEPTED "
+                          "mailbox1=0x%08x\n",
+                          mailbox1);
+            }
+            NV_PRINTF(LEVEL_ERROR,
+                      "CMP40_COMPUTE_UNLOCK_V526: SIGNED_FULLSPEED_STOCK_RELOCK_WPR_DOWN_PASS\n");
+            return NV_OK;
+        }
+
+        NV_PRINTF(LEVEL_ERROR,
+                  "CMP40_STOCKFLOW_V551: SIGNED_EXACT_STATE_MISMATCH "
