+#define CMP40_SEC2_RESET_PLM_FWSEC    0x000000FFU
+#define CMP40_SEC2_RESET_PLM_POSTEXIT 0x000000FFU
+#define CMP40_SEC2_DMEM_CLEAR_START   0x00000000U
+#define CMP40_SEC2_DMEM_CLEAR_END     0x00010000U
