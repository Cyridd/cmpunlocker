+                  kflcnRegRead_HAL(
+                      pGpu, staticCast(pKernelSec2, KernelFalcon),
+                      CMP40_FALCON_TRACEPC),
+                  GPU_REG_RD32(pGpu, CMP40_WPR2_ADDR_HI),
+                  GPU_REG_RD32(pGpu, CMP40_WPR2_ADDR_LO),
+                  GPU_REG_RD32(pGpu, CMP40_FECS_SPEED_PLM),
+                  GPU_REG_RD32(pGpu, CMP40_FECS_SPEED0),
+                  GPU_REG_RD32(pGpu, CMP40_FECS_SPEED1),
+                  GPU_REG_RD32(pGpu, CMP40_SEC2_RESET_PLM));
+        return NV_ERR_INVALID_STATE;
+    }
