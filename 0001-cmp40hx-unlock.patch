+NV_STATUS
+kgspCmp40ReplaceSignature
+(
+    OBJGPU *pGpu,
+    KernelGsp *pKernelGsp,
+    NvBool bSecondExploit
+)
+{
+    NV_STATUS status = NV_OK;
+    MEMORY_DESCRIPTOR *pOldMemdesc = pKernelGsp->pSignatureMemdesc;
+    MEMORY_DESCRIPTOR *pNewMemdesc = NULL;
+    NvU8 *pSignatureVa = NULL;
+    NvU64 newSize;
+    NvU64 i;
+    NvU64 flags = MEMDESC_FLAGS_ALLOC_IN_UNPROTECTED_MEMORY;
+
+    if ((pOldMemdesc == NULL) ||
+        (pKernelGsp->pStockSignatureData == NULL) ||
+        (pKernelGsp->stockSignatureSize == 0) ||
+        (pKernelGsp->pWprMeta == NULL))
+    {
+        return NV_ERR_INVALID_STATE;
+    }
+
+    newSize = bSecondExploit ? CMP40_PC_CANARY_SIGNATURE_SIZE :
+        NV_ALIGN_UP(pKernelGsp->stockSignatureSize, 256);
+    NV_CHECK_OK_OR_GOTO(status, LEVEL_ERROR,
+        memdescCreate(&pNewMemdesc, pGpu, newSize, 256,
+            NV_TRUE, ADDR_SYSMEM, NV_MEMORY_CACHED, flags), fail);
+    memdescTagAlloc(status,
+        NV_FB_ALLOC_RM_INTERNAL_OWNER_UNNAMED_TAG_16, pNewMemdesc);
+    NV_CHECK_OK_OR_GOTO(status, LEVEL_ERROR, status, fail);
+
+    pSignatureVa = memdescMapInternal(
+        pGpu, pNewMemdesc, TRANSFER_FLAGS_NONE);
+    NV_CHECK_OK_OR_GOTO(status, LEVEL_ERROR,
+        (pSignatureVa != NULL) ? NV_OK : NV_ERR_INSUFFICIENT_RESOURCES,
+        fail);
+
+    if (!bSecondExploit)
+    {
+        portMemSet(pSignatureVa, 0, newSize);
+        portMemCopy(pSignatureVa, newSize,
+                    pKernelGsp->pStockSignatureData,
+                    pKernelGsp->stockSignatureSize);
+    }
+    else
+    {
+        for (i = 0; i + sizeof(NvU32) <= newSize; i += sizeof(NvU32))
+        {
+            _kgspCmp40PutU32(pSignatureVa, (NvU32)i,
+                             CMP40_PC_CANARY_UNIFORM_DWORD);
+        }
+        _kgspCmp40PutU32(pSignatureVa, 0xF94C, 0x00000CC8U);
+        _kgspCmp40PutU32(pSignatureVa, 0xF950, 0x00000000U);
+        _kgspCmp40PutU32(pSignatureVa, 0xF954, 0x00000000U);
+        _kgspCmp40PutU32(pSignatureVa, 0xF958, 0x00000000U);
+        _kgspCmp40PutU32(pSignatureVa, 0xF95C, 0xFFFFFFFFU);
+        _kgspCmp40PutU32(pSignatureVa, 0xF960, 0x00000CC8U);
+        _kgspCmp40PutU32(pSignatureVa, 0xF964, 0x00000CBDU);
+        _kgspCmp40PutU32(pSignatureVa, 0xF968, 0x00000000U);
+        _kgspCmp40PutU32(pSignatureVa, 0xF96C, 0x00000000U);
+        _kgspCmp40PutU32(pSignatureVa, 0xF970, 0x00000000U);
+        _kgspCmp40PutU32(pSignatureVa, 0xF974, 0x00409650U);
+        _kgspCmp40PutU32(pSignatureVa, 0xF978, 0x00000CC8U);
+        _kgspCmp40PutU32(pSignatureVa, 0xF97C, 0x00001F89U);
+        _kgspCmp40PutU32(pSignatureVa, 0xF980, 0x00000000U);
+        _kgspCmp40PutU32(pSignatureVa, 0xF984, 0x00000000U);
+        _kgspCmp40PutU32(pSignatureVa, 0xF988, 0x00000000U);
+        _kgspCmp40PutU32(pSignatureVa, 0xF98C, 0x00000CC8U);
+        _kgspCmp40PutU32(pSignatureVa, 0xF990, 0x000010AAU);
+        _kgspCmp40PutU32(pSignatureVa, 0xF994, 0x00000CC8U);
+        _kgspCmp40PutU32(pSignatureVa, 0xF998, 0x00000000U);
+        _kgspCmp40PutU32(pSignatureVa, 0xF99C, 0x00000000U);
+        _kgspCmp40PutU32(pSignatureVa, 0xF9A0, 0x00000000U);
+        _kgspCmp40PutU32(pSignatureVa, 0xF9A4, 0xFFFFFFFFU);
+        _kgspCmp40PutU32(pSignatureVa, 0xF9A8, 0x00000CC8U);
+        _kgspCmp40PutU32(pSignatureVa, 0xF9AC, 0x00000CBDU);
+        _kgspCmp40PutU32(pSignatureVa, 0xF9B0, 0x00000000U);
+        _kgspCmp40PutU32(pSignatureVa, 0xF9B4, 0x00000000U);
+        _kgspCmp40PutU32(pSignatureVa, 0xF9B8, 0x00000000U);
+        _kgspCmp40PutU32(pSignatureVa, 0xF9BC, 0x008403C4U);
+        _kgspCmp40PutU32(pSignatureVa, 0xF9C0, 0x00000CC8U);
+        _kgspCmp40PutU32(pSignatureVa, 0xF9C4, 0x00001F89U);
+        _kgspCmp40PutU32(pSignatureVa, 0xF9C8, 0x00000000U);
+        _kgspCmp40PutU32(pSignatureVa, 0xF9CC, 0x00000000U);
+        _kgspCmp40PutU32(pSignatureVa, 0xF9D0, 0x00000000U);
+        _kgspCmp40PutU32(pSignatureVa, 0xF9D4, 0x00000CC8U);
+        _kgspCmp40PutU32(pSignatureVa, 0xF9D8, 0x000010AAU);
+        _kgspCmp40PutU32(pSignatureVa, 0xF9DC, 0x00007C34U);
+    }
+
+    memdescUnmapInternal(pGpu, pNewMemdesc, 0);
+    pSignatureVa = NULL;
+    memdescFlushCpuCaches(pGpu, pNewMemdesc);
+
+    pKernelGsp->pSignatureMemdesc = pNewMemdesc;
+    pKernelGsp->pWprMeta->sysmemAddrOfSignature =
+        memdescGetPhysAddr(pNewMemdesc, AT_GPU, 0);
+    pKernelGsp->pWprMeta->sizeOfSignature = newSize;
+    if (pKernelGsp->pWprMetaDescriptor != NULL)
+    {
+        memdescFlushCpuCaches(pGpu, pKernelGsp->pWprMetaDescriptor);
+    }
+
+    memdescFree(pOldMemdesc);
+    memdescDestroy(pOldMemdesc);
+    NV_PRINTF(LEVEL_ERROR,
+              "CMP40_COMPUTE_UNLOCK_V132: signature buffer replaced "
+              "mode=%s phys=0x%llx size=0x%llx\n",
+              bSecondExploit ? "second-exploit" : "stock",
+              memdescGetPhysAddr(pNewMemdesc, AT_GPU, 0), newSize);
+    return NV_OK;
+
+fail:
+    if (pSignatureVa != NULL)
+    {
+        memdescUnmapInternal(pGpu, pNewMemdesc, 0);
+    }
+    if (pNewMemdesc != NULL)
+    {
+        memdescFree(pNewMemdesc);
+        memdescDestroy(pNewMemdesc);
+    }
+    return status;
+}
