+#define CMP40_FECS_SPEED_PLM_OPEN    0xFFFFFFFFU
+#define CMP40_FECS_SPEED_PLM_STAGED  0xFFFFFF8FU
+#define CMP40_FECS_SPEED0            0x00409664U
+#define CMP40_FECS_SPEED1            0x0040966CU
+#define CMP40_FECS_SPEED0_STAGED     0x88888888U
+#define CMP40_FECS_SPEED1_STAGED     0x00000008U
