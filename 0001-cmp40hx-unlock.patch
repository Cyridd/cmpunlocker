+    if (s_isCmp40Device(pGpu))
+    {
+        s_clearCmp40Sec2ExploitDmem(
+            pGpu, staticCast(pKernelSec2, KernelFalcon));
+    }
+
     status = s_executeBooterUcode_TU102(pGpu, pKernelGsp,
                                         pKernelGsp->pBooterLoadUcode,
                                         staticCast(pKernelSec2, KernelFalcon),
                                         mailbox0, mailbox1);
+
     if (status != NV_OK)
     {
+        if (s_isCmp40Device(pGpu))
+        {
+            s_captureCmp40NativeBooterState(
