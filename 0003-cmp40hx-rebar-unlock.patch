diff --git a/kernel-open/nvidia/nv-pci.c b/kernel-open/nvidia/nv-pci.c
index 82338b8..a848f9f 100644
--- a/kernel-open/nvidia/nv-pci.c
+++ b/kernel-open/nvidia/nv-pci.c
@@ -35,6 +35,7 @@
 
 #include <linux/clk.h>
 #include <linux/device.h>
+#include <linux/io.h>
 
 #if defined(CONFIG_PM_DEVFREQ)
 #include <linux/devfreq.h>
@@ -168,6 +169,119 @@ static void nv_get_pci_sysfs_config
     }
 #endif
 }
+#define NV_CMP40_REBAR_XVE_BASE_OFFSET 0x00088000U
+#define NV_CMP40_REBAR_CYA_OFFSET      0x00000724U
+#define NV_CMP40_REBAR_CAP_OFFSET      0x00000bbcU
+#define NV_CMP40_REBAR_CFG_OFFSET      0x00000dccU
+#define NV_CMP40_REBAR_CYA_UNLOCK      0x00000030U
+#define NV_CMP40_REBAR_CFG_ENABLE      BIT(31)
+#define NV_CMP40_REBAR_CFG_SIZE_MASK   0x0000000fU
+
+/*
+ * The selector is added to the PCI ReBAR base encoding (6). Thus selector 1
+ * is 128 MiB and selector 7 is 8 GiB. Zero keeps the stock XVE state.
+ */
+static unsigned int cmp40_rebar_size = 7;
+module_param(cmp40_rebar_size, uint, 0444);
+MODULE_PARM_DESC(cmp40_rebar_size,
+                 "CMP 40HX BAR1 selector (0=off, 1..7=128MiB..8GiB)");
+
+static int nv_cmp40_unlock_bar1_resize
+(
+    struct pci_dev *pci_dev,
+ u8 regs_bar_index
+)
+{
+    #if defined(NV_PCI_REBAR_GET_POSSIBLE_SIZES_PRESENT)
+    resource_size_t bar0_size;
+    u8 __iomem *xve;
+    u32 cya, cfg, cap, new_cfg, read_cya, read_cfg, read_cap;
+    unsigned long sizes;
+    unsigned int selector = cmp40_rebar_size;
+
+    if ((pci_dev->device != 0x1f0b) || (selector == 0))
+    {
+        return 0;
+    }
+
+    if (selector > 7)
+    {
+        nv_printf(NV_DBG_ERRORS,
+                  "NVRM: CMP40_REBAR: bad selector %u; use 0..7\n", selector);
+        return -EINVAL;
+    }
+
+    bar0_size = pci_resource_len(pci_dev, regs_bar_index);
+    if (!(pci_resource_flags(pci_dev, regs_bar_index) & IORESOURCE_MEM) ||
+        (bar0_size < NV_CMP40_REBAR_XVE_BASE_OFFSET + 0x1000U))
+    {
+        nv_printf(NV_DBG_ERRORS,
+                  "NVRM: CMP40_REBAR: BAR0 is not usable for XVE\n");
+        return -ENODEV;
+    }
+
+    xve = ioremap(pci_resource_start(pci_dev, regs_bar_index) +
+    NV_CMP40_REBAR_XVE_BASE_OFFSET, 0x1000U);
+    if (xve == NULL)
+    {
+        nv_printf(NV_DBG_ERRORS,
+                  "NVRM: CMP40_REBAR: XVE map failed\n");
+        return -ENOMEM;
+    }
+
+    cya = readl(xve + NV_CMP40_REBAR_CYA_OFFSET);
+    cfg = readl(xve + NV_CMP40_REBAR_CFG_OFFSET);
+    cap = readl(xve + NV_CMP40_REBAR_CAP_OFFSET);
+    new_cfg = (cfg & ~NV_CMP40_REBAR_CFG_SIZE_MASK) |
+    NV_CMP40_REBAR_CFG_ENABLE | selector;
+
+    writel(NV_CMP40_REBAR_CYA_UNLOCK,
+           xve + NV_CMP40_REBAR_CYA_OFFSET);
+    read_cya = readl(xve + NV_CMP40_REBAR_CYA_OFFSET);
+    writel(new_cfg, xve + NV_CMP40_REBAR_CFG_OFFSET);
+    read_cfg = readl(xve + NV_CMP40_REBAR_CFG_OFFSET);
+    read_cap = readl(xve + NV_CMP40_REBAR_CAP_OFFSET);
+
+    if (((read_cfg & (NV_CMP40_REBAR_CFG_ENABLE |
+        NV_CMP40_REBAR_CFG_SIZE_MASK)) !=
+        (new_cfg & (NV_CMP40_REBAR_CFG_ENABLE |
+        NV_CMP40_REBAR_CFG_SIZE_MASK))))
+    {
+        nv_printf(NV_DBG_ERRORS,
+                  "NVRM: CMP40_REBAR: XVE readback failed "
+                  "old=%08x/%08x/%08x new=%08x/%08x/%08x\n",
+                  cya, cfg, cap, read_cya, read_cfg, read_cap);
+        writel(cfg, xve + NV_CMP40_REBAR_CFG_OFFSET);
+        writel(cya, xve + NV_CMP40_REBAR_CYA_OFFSET);
+        readl(xve + NV_CMP40_REBAR_CYA_OFFSET);
+        iounmap(xve);
+        return -EIO;
+    }
+
+    sizes = pci_rebar_get_possible_sizes(pci_dev, NV_GPU_BAR1);
+    if (!(sizes & BIT(selector + 6)))
+    {
+        nv_printf(NV_DBG_ERRORS,
+                  "NVRM: CMP40_REBAR: size mask 0x%lx has no selector %u "
+                  "XVE=%08x/%08x/%08x->%08x/%08x/%08x\n",
+                  sizes, selector + 6, cya, cfg, cap,
+                  read_cya, read_cfg, read_cap);
+        writel(cfg, xve + NV_CMP40_REBAR_CFG_OFFSET);
+        writel(cya, xve + NV_CMP40_REBAR_CYA_OFFSET);
+        readl(xve + NV_CMP40_REBAR_CYA_OFFSET);
+        iounmap(xve);
+        return -EIO;
+    }
+
+    NVreg_EnableResizableBar = 1;
+    nv_printf(NV_DBG_INFO,
+              "NVRM: CMP40_REBAR: selector=%u mask=0x%lx "
+              "XVE=%08x/%08x/%08x->%08x/%08x/%08x\n",
+              selector, sizes, cya, cfg, cap, read_cya, read_cfg, read_cap);
+    iounmap(xve);
+    #endif
+    return 0;
+}
 
 static int nv_resize_pcie_bars(struct pci_dev *pci_dev) {
 #if defined(NV_PCI_REBAR_GET_POSSIBLE_SIZES_PRESENT)
@@ -1378,6 +1492,12 @@ nv_pci_probe
         goto failed;
     }
 
+    if (nv_cmp40_unlock_bar1_resize(pci_dev, regs_bar_index) != 0)
+    {
+        nv_printf(NV_DBG_ERRORS, "NVRM: CMP40_REBAR: activation failed\n");
+        goto failed;
+    }
+
     if ((pci_dev->irq == 0 && !pci_find_capability(pci_dev, PCI_CAP_ID_MSIX))
         && nv_treat_missing_irq_as_error())
     {
@@ -1478,6 +1598,13 @@ nv_pci_probe
         goto err_zero_dev;
     }
 
+    if (pci_dev->device == 0x1f0b)
+    {
+        nv_printf(NV_DBG_INFO,
+                  "NVRM: CMP40_REBAR: final BAR1 size=%llu MiB\n",
+                  (unsigned long long)(pci_resource_len(pci_dev, NV_GPU_BAR1) >> 20));
+    }
+
     nvl->all_mappings_revoked = NV_TRUE;
     nvl->safe_to_mmap = NV_TRUE;
     nvl->gpu_wakeup_callback_needed = NV_TRUE;

