+static NvBool
+nv_cmp40hx_is_supported(struct pci_dev *gpu)
+{
+    return (gpu != NULL) &&
+    (gpu->vendor == PCI_VENDOR_ID_NVIDIA) &&
+    (gpu->device == 0x1f0b);
+}
+
+static void
+nv_cmp40hx_retrain_gen2(nv_state_t *nv)
+{
+    nv_linux_state_t *nvl = NV_GET_NVL_FROM_NV_STATE(nv);
+    struct pci_dev   *gpu = nvl->pci_dev;
+    struct pci_dev   *upstream;
+    void __iomem     *bar0;
+    u16  gpu_ctl2, upstream_ctl2, upstream_ctl, link_status = 0;
+    u32  cya0, link_config, pl_link_rate;
+    int  ret, attempt;
+
+    if (!nv_cmp40hx_is_supported(gpu))
+        return;
+
+    upstream = pci_upstream_bridge(gpu);
+    if (!upstream) {
+        NV_DEV_PRINTF(NV_DBG_ERRORS, nv,
+                      "CMP Gen2: no upstream bridge\n");
+        return;
+    }
+
+    bar0 = ioremap(pci_resource_start(gpu, 0), 0x90000);
+    if (!bar0) {
+        NV_DEV_PRINTF(NV_DBG_ERRORS, nv,
+                      "CMP Gen2: BAR0 map failed\n");
+        return;
+    }
+
+    cya0         = readl(bar0 + 0x8c2c0);
+    link_config  = readl(bar0 + 0x8c040);
+    pl_link_rate = readl(bar0 + 0x8c1c0);
 
+    NV_DEV_PRINTF(NV_DBG_ERRORS, nv,
+                  "CMP Gen2: CYA=%08x(DIS_G2=%u) "
+                  "CFG=%08x(bits[19:18]=%u) "
+                  "PL=%08x(bits[18:17]=%u)\n",
+                  cya0, (cya0 >> 2) & 1U,
+                  link_config, (link_config >> 18) & 3U,
+                  pl_link_rate, (pl_link_rate >> 17) & 3U);
+
+    if (((cya0 & (1U << 2)) != 0U) ||
+        (((link_config  >> 18) & 3U) != 2U) ||
+        (((pl_link_rate >> 17) & 3U) != 2U))
+    {
+        NV_DEV_PRINTF(NV_DBG_ERRORS, nv,
+                      "CMP Gen2: GSP policy not ready; retrain skipped\n");
+        iounmap(bar0);
+        return;
+    }
+
+    writel(6U, bar0 + 0x8872c);
+    (void)readl(bar0 + 0x8872c);
+    iounmap(bar0);
+    msleep(50);
+
+    ret = pcie_capability_read_word(gpu,      PCI_EXP_LNKCTL2, &gpu_ctl2);
+    if (ret) goto cap_err;
+    ret = pcie_capability_read_word(upstream, PCI_EXP_LNKCTL2, &upstream_ctl2);
+    if (ret) goto cap_err;
+
+    gpu_ctl2      = (gpu_ctl2      & ~PCI_EXP_LNKCTL2_TLS) | PCI_EXP_LNKCTL2_TLS_5_0GT;
+    upstream_ctl2 = (upstream_ctl2 & ~PCI_EXP_LNKCTL2_TLS) | PCI_EXP_LNKCTL2_TLS_5_0GT;
+
+    ret = pcie_capability_write_word(gpu,      PCI_EXP_LNKCTL2, gpu_ctl2);
+    if (ret) goto cap_err;
+    ret = pcie_capability_write_word(upstream, PCI_EXP_LNKCTL2, upstream_ctl2);
+    if (ret) goto cap_err;
+    ret = pcie_capability_read_word(upstream,  PCI_EXP_LNKCTL,  &upstream_ctl);
+    if (ret) goto cap_err;
+    ret = pcie_capability_write_word(upstream, PCI_EXP_LNKCTL,
+                                     upstream_ctl | PCI_EXP_LNKCTL_RL);
+    if (ret) goto cap_err;
+
+    for (attempt = 0; attempt < 20; attempt++) {
+        msleep(100);
+        ret = pcie_capability_read_word(gpu, PCI_EXP_LNKSTA, &link_status);
+        if (!ret &&
+            ((link_status & PCI_EXP_LNKSTA_CLS) >= PCI_EXP_LNKSTA_CLS_5_0GB))
+        {
+            NV_DEV_PRINTF(NV_DBG_ERRORS, nv,
+                          "CMP Gen2: RETRAIN_PASS status=%04x attempt=%d\n",
+                          link_status, attempt + 1);
+            return;
+        }
+    }
+    NV_DEV_PRINTF(NV_DBG_ERRORS, nv,
+                  "CMP Gen2: RETRAIN_FAIL status=%04x\n", link_status);
+    return;
+
+    cap_err:
+    NV_DEV_PRINTF(NV_DBG_ERRORS, nv,
+                  "CMP Gen2: PCI cap error=%d\n", ret);
+}
